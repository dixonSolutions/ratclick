[Unit]
Description=RatClick auto-clicker service
Documentation=https://github.com/dixonSolutions/ratclick
# The daemon needs the session bus, which only exists once the user session is up.
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=dbus
BusName=io.github.dixonsolutions.RatClick.Daemon
ExecStart=/usr/libexec/ratclick/ratclickd
Restart=on-failure
RestartSec=2
# Never restart in a tight loop if /dev/uinput is unavailable.
StartLimitIntervalSec=60
StartLimitBurst=3

# The daemon only needs uinput and the session bus.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictNamespaces=true
RestrictRealtime=true
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
# The config lives under XDG_CONFIG_HOME, which ProtectHome=read-only would
# otherwise make unwritable for the daemon. It only ever reads it, so read-only
# is correct — the CLI and GUI are what write.

[Install]
WantedBy=graphical-session.target
